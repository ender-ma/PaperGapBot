# --- Required ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:paste-your-token-from-BotFather

# Keep the bot private: comma-separated Telegram user ids (send /whoami to the bot)
ALLOWED_USER_IDS=

# --- Paper sources --------------------------------------------------------------
# Free key: create an account at openalex.org, then openalex.org/settings/api
OPENALEX_API_KEY=
# Your email (sent politely to OpenAlex / Europe PMC)
CONTACT_EMAIL=
# Stop before the free $1/day OpenAlex allowance runs out
OPENALEX_DAILY_BUDGET_USD=0.90
# openalex, europepmc, arxiv (comma-separated)
DEFAULT_SOURCES=openalex

# --- Run size and the specificity gate ------------------------------------------
DEFAULT_MAX_PAPERS=20000
HARD_MAX_PAPERS=300000
MIN_CORPUS=100
MAX_CORPUS=500000
GATE_MIN_SCORE=70
GATE_LLM_REVIEW=true
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0

# --- Question writer (optional) --------------------------------------------------
# auto | anthropic | openai | none
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible endpoint instead (OpenRouter, Groq, Ollama ...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
QUESTIONS_PER_RUN=8

# --- Storage ------------------------------------------------------------------------
DB_PATH=data/papergap.db
REPORTS_DIR=data/reports
KEEP_PAPERS=false
MAX_CONCURRENT_JOBS=2
LOG_LEVEL=INFO
